#include <stdint.h>

#include "shell.h"
#include "terminal.h"

#define SHELL_BUFFER_SIZE 128

static char shell_buffer[SHELL_BUFFER_SIZE];
static uint32_t shell_length = 0;

static void shell_prompt(void)
{
    terminal_write("spectre> ");
}

static void shell_clear_buffer(void)
{
    for (uint32_t i = 0; i < SHELL_BUFFER_SIZE; i++)
    {
        shell_buffer[i] = 0;
    }

    shell_length = 0;
}

static int shell_string_equals(
    const char* a,
    const char* b
)
{
    while (*a && *b)
    {
        if (*a != *b)
        {
            return 0;
        }

        a++;
        b++;
    }

    return (*a == '\0' && *b == '\0');
}

static void shell_execute(void)
{
    shell_buffer[shell_length] = '\0';

    terminal_putchar('\n');

    if (shell_length == 0)
    {
        shell_prompt();
        return;
    }

    if (shell_string_equals(shell_buffer, "help"))
    {
        terminal_write(
            "SpectreOS shell commands:\n"
            "  help     - Show this help\n"
            "  clear    - Clear the terminal\n"
            "  echo     - Print text\n"
            "  about    - Show SpectreOS information\n"
            "  sysinfo  - Show kernel information\n"
            "  getpid   - Show current process ID\n"
        );
    }
    else if (shell_string_equals(shell_buffer, "clear"))
    {
        terminal_clear();
    }
    else if (shell_string_equals(shell_buffer, "about"))
    {
        terminal_write(
            "SpectreOS\n"
            "A lightweight Unix-inspired operating system.\n"
            "Built from scratch in C and Assembly.\n"
        );
    }
    else if (shell_string_equals(shell_buffer, "sysinfo"))
    {
        terminal_write(
            "SpectreOS system information:\n"
            "Architecture: i386\n"
            "Kernel: SpectreOS\n"
            "Terminal: VGA text mode\n"
            "Keyboard: PS/2\n"
        );
    }
    else if (shell_string_equals(shell_buffer, "getpid"))
    {
        terminal_write(
            "PID: 1\n"
        );
    }
    else
    {
        terminal_write(
            "Unknown command: "
        );

        terminal_write(shell_buffer);

        terminal_write(
            "\nType 'help' for available commands.\n"
        );
    }

    shell_clear_buffer();

    shell_prompt();
}

void shell_init(void)
{
    shell_clear_buffer();
}

void shell_start(void)
{
    shell_prompt();
}

void shell_handle_character(char c)
{
    /*
     * Enter
     */
    if (c == '\n')
    {
        shell_execute();
        return;
    }

    /*
     * Backspace
     */
    if (c == '\b')
    {
        if (shell_length > 0)
        {
            shell_length--;

            shell_buffer[shell_length] = '\0';

            terminal_backspace();
        }

        return;
    }

    /*
     * Ignore non-printable characters.
     */
    if ((uint8_t)c < 32)
    {
        return;
    }

    /*
     * Prevent buffer overflow.
     */
    if (shell_length >= SHELL_BUFFER_SIZE - 1)
    {
        return;
    }

    shell_buffer[shell_length++] = c;

    terminal_putchar(c);
}
